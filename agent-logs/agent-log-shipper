def connect_unix(path):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.connect(path)
    except OSError:
        s.close()
        raise
    return s


def connect_vsock(cid, port, source_ports=VSOCK_SOURCE_PORTS):
    """Connect from a random source port in source_ports.  Binding a vsock
    port below 1024 needs CAP_NET_BIND_SERVICE, which is how agent-logd
    knows the sender is privileged inside its VM (docs/design/background.md,
    "vsock")."""
    s = socket.socket(socket.AF_VSOCK, socket.SOCK_STREAM)
    try:
        ports = list(range(source_ports[0], source_ports[1] + 1))
        random.shuffle(ports)
        for p in ports:
            try:
                s.bind((socket.VMADDR_CID_ANY, p))
                break
            except OSError as e:
                if e.errno != errno.EADDRINUSE:
                    raise
        else:
            raise OSError(errno.EADDRINUSE, "no free vsock source port")
        s.connect((cid, port))
    except OSError:
        s.close()
        raise
    return s


class ProtocolError(Exception):
    pass


def read_reply(sock, timeout=ACK_TIMEOUT):
    sock.settimeout(timeout)
    buf = b""
    while not buf.endswith(b"\n"):
        chunk = sock.recv(1024)
        if not chunk:
            raise ProtocolError("connection closed before ack")
        buf += chunk
        if len(buf) > 4096:
            raise ProtocolError("over-long reply")
    return json.loads(buf)


class Sender:
    """Takes records round-robin from every source, sends them as an NDJSON
    batch ending with {"batch": n}, waits for {"ack": n}, then persists the
    cursors.  Retries the same batch with exponential backoff."""

    def __init__(self, sources, state, connect, ack_timeout=ACK_TIMEOUT, max_backoff=60.0):
        self.sources = sources
        self.state = state
        self.connect = connect
        self.ack_timeout = ack_timeout
        self.max_backoff = max_backoff
        self.sock = None
        self.n = 0

    def start(self):
        threading.Thread(target=self.run, name="sender", daemon=True).start()

    def collect(self, wait=1.0):
        batch, size = [], 0
        deadline = time.monotonic() + wait
        while True:
            progress = False
            for src in self.sources:
                if len(batch) >= BATCH_MAX_RECORDS or size >= BATCH_MAX_BYTES:
                    return batch
                try:
                    rec, cursor = src.queue.get_nowait()
                except queue.Empty:
                    continue
                line = encode_json(rec) + b"\n"
                batch.append((src, line, cursor))
                size += len(line)
                progress = True
            if batch and not progress:
                return batch
            if not batch:
                if time.monotonic() >= deadline:
                    return batch
                time.sleep(0.05)

    def send_batch(self, batch):
        self.n += 1
        payload = b"".join(line for _, line, _ in batch) + encode_json({"batch": self.n}) + b"\n"
        if self.sock is None:
            self.sock = self.connect()
        self.sock.settimeout(self.ack_timeout)
        self.sock.sendall(payload)
        reply = read_reply(self.sock, self.ack_timeout)
        if reply != {"ack": self.n}:
            raise ProtocolError(f"unexpected reply {reply!r}")

    def commit(self, batch):
        touched = []
        for src, _, cursor in batch:
            if cursor is not None:
                src.apply_commit(cursor)
            if src not in touched:
                touched.append(src)
        cursors = self.state.get("cursors", {}) or {}
        for src in touched:
            cursors[src.name] = src.committed()
        self.state.update(cursors=cursors)
        for src in touched:
            src.after_commit()

    def run(self):
        while True:
            batch = self.collect()
            if not batch:
                continue
            delay = 1.0
            while True:
                try:
                    self.send_batch(batch)
                    break
                except (OSError, ProtocolError, ValueError) as e:
                    log_err(f"sender: delivery failed ({e}); retrying in {delay:.0f}s")
                    if self.sock is not None:
                        self.sock.close()
                        self.sock = None
                    time.sleep(delay)
                    delay = min(delay * 2, self.max_backoff)
            self.commit(batch)


