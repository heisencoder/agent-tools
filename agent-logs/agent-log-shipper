def parse_ports(text):
    lo, _, hi = text.partition("-")
    return int(lo), int(hi or lo)


def parse_args(argv):
    p = argparse.ArgumentParser(description="Hook collector and log shipper.")
    p.add_argument("--mode", required=True, choices=["host", "vm", "local"],
                   help="host: ship to the local agent-logd unix socket; vm: ship over vsock; "
                        "local: phase 1, collector and spool only")
    p.add_argument("--hook-socket", default=HOOK_SOCKET)
    p.add_argument("--runtime-dir", default=RUNTIME_DIR,
                   help="where the audit-degraded flag file lives")
    p.add_argument("--state-dir", default=STATE_DIR)
    p.add_argument("--spool-cap", type=int, default=SPOOL_CAP, help="bytes")
    p.add_argument("--segment-size", type=int, default=SEGMENT_SIZE, help="bytes")
    p.add_argument("--logd-unix", default=LOGD_UNIX)
    p.add_argument("--logd-cid", type=int, default=LOGD_CID)
    p.add_argument("--logd-port", type=int, default=LOGD_PORT)
    p.add_argument("--vsock-source-ports", type=parse_ports, default=VSOCK_SOURCE_PORTS,
                   metavar="LO-HI", help="test only: source port range (default 600-1023)")
    p.add_argument("--envs-conf", default=ENVS_CONF)
    p.add_argument("--audit-log", default=AUDIT_LOG, help="'' disables the audit source")
    p.add_argument("--auditd-conf", default=AUDITD_CONF)
    p.add_argument("--audit-check-interval", type=float, default=60.0)
    p.add_argument("--journalctl", default="journalctl", help="'' disables the journal source")
    p.add_argument("--agent-user", default="agent")
    p.add_argument("--transcripts-dir", action="append",
                   help="default: ~AGENT_USER/.claude/projects (repeatable)")
    p.add_argument("--egress-user", default="agent-egress")
    p.add_argument("--logd-user", default="agent-logd")
    p.add_argument("--proc-root", default="/proc", help="test only")
    return p.parse_args(argv)


def main(argv=None):
    args = parse_args(argv)
    boot_id = read_boot_id(args.proc_root)
    os.makedirs(args.state_dir, mode=0o700, exist_ok=True)
    os.makedirs(args.runtime_dir, mode=0o755, exist_ok=True)
    state = State(os.path.join(args.state_dir, "state.json"))
    spool = Spool(os.path.join(args.state_dir, "spool"), state, args.segment_size,
                  args.spool_cap, local=args.mode == "local")

    transcripts = None
    if args.mode != "local":
        try:
            agent = pwd.getpwnam(args.agent_user)
            agent_uid, agent_home = agent.pw_uid, agent.pw_dir
        except KeyError:
            log_err(f"user {args.agent_user!r} not found; transcript source disabled")
            agent_uid, agent_home = None, None
        if agent_uid is not None:
            roots = args.transcripts_dir or [os.path.join(agent_home, ".claude", "projects")]
            transcripts = TranscriptSource(state, roots, agent_uid, boot_id)

    collector = Collector(args.hook_socket, spool, boot_id, args.proc_root,
                          on_paths=transcripts.add_paths if transcripts else None)
    health = AuditHealth(args.auditd_conf, os.path.dirname(args.audit_log or AUDIT_LOG),
                         os.path.join(args.runtime_dir, "audit-degraded"),
                         collector.emit_meta, args.audit_check_interval)

    collector.start()
    health.check_once()
    threading.Thread(target=health.run, name="audit-health", daemon=True).start()

    if args.mode != "local":
        sources = [HookSpoolSource(state, spool, collector.wakeup)]
        if args.journalctl:
            sources.append(JournalSource(state, args.journalctl, uid_of(args.egress_user),
                                         uid_of(args.logd_user), args.envs_conf))
        if args.audit_log:
            sources.append(AuditSource(state, args.audit_log, boot_id, read_btime(args.proc_root)))
        if transcripts:
            sources.append(transcripts)
        if args.mode == "host":
            connect = lambda: connect_unix(args.logd_unix)  # noqa: E731
        else:
            connect = lambda: connect_vsock(args.logd_cid, args.logd_port,  # noqa: E731
                                            args.vsock_source_ports)
        for src in sources:
            src.start()
        Sender(sources, state, connect).start()
        log(f"shipping ({args.mode}) sources: {', '.join(s.name for s in sources)}")
    else:
        log("local-only mode: hook records stay in the spool")

    stop = threading.Event()
    signal.signal(signal.SIGTERM, lambda *_: stop.set())
    signal.signal(signal.SIGINT, lambda *_: stop.set())
    stop.wait()
    log("stopping")
    return 0


if __name__ == "__main__":
    sys.exit(main())
