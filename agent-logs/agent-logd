# Daemon
# -----------------------------------------------------------------

def listen_fds(environ, pid):
    """systemd socket passing: [(fd, name)] from LISTEN_PID/LISTEN_FDS/
    LISTEN_FDNAMES (fds start at 3)."""
    if environ.get("LISTEN_PID") != str(pid):
        return []
    try:
        count = int(environ.get("LISTEN_FDS", "0"))
    except ValueError:
        return []
    names = environ.get("LISTEN_FDNAMES", "").split(":") if environ.get("LISTEN_FDNAMES") else []
    return [(3 + i, names[i] if i < len(names) else "unknown") for i in range(count)]


class Daemon:
    def __init__(self, store, registry, allow_any_uid=False, vsock_allow_loopback=False,
                 vsock_allow_unprivileged=False):
        self.store = store
        self.registry = registry
        self.allow_any_uid = allow_any_uid
        self.vsock_allow_loopback = vsock_allow_loopback
        self.vsock_allow_unprivileged = vsock_allow_unprivileged

    def store_records(self, env, records, otel=False):
        for rec in records:
            line_len = len(encode_json(rec))
            if line_len > LINE_MAX:
                digest = hashlib.sha256(encode_json(rec)).hexdigest()
                rec = meta_record("oversize", f"oversize:{rec['source']}:{rec['source_id']}",
                                  {"source": rec["source"], "source_id": rec["source_id"],
                                   "length": line_len, "sha256": digest}, env, rec["recv_ts"])
            self.store.append(env, rec, otel=otel)
        self.store.sync()

    def serve(self, sock, kind):
        """Accept loop for one listening socket (kind: vsock, unix, otlp)."""
        if kind == "otlp":
            threading.Thread(target=OTLPServer(sock, self).serve_forever, daemon=True,
                             name="otlp").start()
            return
        threading.Thread(target=self._accept, args=(sock, kind), daemon=True,
                         name=f"accept-{kind}").start()

    def _accept(self, sock, kind):
        while True:
            try:
                conn, addr = sock.accept()
            except OSError as e:
                log_err(f"{kind}: accept failed: {e}")
                time.sleep(0.5)
                continue
            threading.Thread(target=self._serve_conn, args=(conn, addr, kind), daemon=True).start()

    def peer_env(self, conn, addr, kind):
        if kind == "vsock":
            cid, port = addr
            return check_vsock_peer(cid, port, self.registry.cids(), self.vsock_allow_loopback,
                                    self.vsock_allow_unprivileged)
        _pid, uid, _gid = struct.unpack("3i", conn.getsockopt(
            socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")))
        return check_unix_peer(uid, self.allow_any_uid)

    def _serve_conn(self, conn, addr, kind):
        try:
            env, reason = self.peer_env(conn, addr, kind)
            if env is None:
                log_err(f"{kind}: rejected peer {addr!r}: {reason}")
                return
            n = handle_ingest(conn, env, self.store)
            log(f"{kind}: {env} disconnected after {n} records")
        except (OSError, ValueError) as e:
            log_err(f"{kind}: connection error: {e}")
        finally:
            conn.close()


def bind_unix(path):
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.bind(path)
    os.chmod(path, 0o600)
    s.listen(64)
    return s


def bind_tcp(spec):
    host, _, port = spec.rpartition(":")
    host = host.strip("[]") or "127.0.0.1"
    family = socket.AF_INET6 if ":" in host else socket.AF_INET
    s = socket.socket(family, socket.SOCK_STREAM)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    s.bind((host, int(port)))
    s.listen(64)
    return s


def bind_vsock(port):
    s = socket.socket(socket.AF_VSOCK, socket.SOCK_STREAM)
    s.bind((socket.VMADDR_CID_ANY, port))
    s.listen(64)
    return s


def parse_args(argv):
    p = argparse.ArgumentParser(description="Receive and store agent audit records.")
    p.add_argument("--store", default=STORE)
    p.add_argument("--envs-conf", default=ENVS_CONF)
    p.add_argument("--quota", type=int, default=QUOTA, help="bytes per environment per day")
    p.add_argument("--listen-unix", metavar="PATH", help="dev/test: bind an ingest unix socket")
    p.add_argument("--listen-vsock", metavar="PORT", type=int, help="dev/test: bind vsock port")
    p.add_argument("--listen-otlp", "--listen-tcp", metavar="HOST:PORT", action="append",
                   default=[], help="dev/test: bind an OTLP/HTTP listener")
    p.add_argument("--allow-any-uid", action="store_true",
                   help="test only: accept non-root unix peers")
    p.add_argument("--vsock-allow-loopback", action="store_true",
                   help="test only: accept CID 1 when it is listed in envs.conf")
    p.add_argument("--vsock-allow-unprivileged", action="store_true",
                   help="test only: accept source ports above 1023")
    return p.parse_args(argv)


def main(argv=None):
    args = parse_args(argv)
    store = Store(args.store, args.quota)
    registry = Registry(args.envs_conf)
    registry.refresh()
    daemon = Daemon(store, registry, args.allow_any_uid, args.vsock_allow_loopback,
                    args.vsock_allow_unprivileged)
    listeners = []
    for fd, name in listen_fds(os.environ, os.getpid()):
        listeners.append((socket.socket(fileno=fd), name))
    for var in ("LISTEN_PID", "LISTEN_FDS", "LISTEN_FDNAMES"):
        os.environ.pop(var, None)
    if args.listen_unix:
        listeners.append((bind_unix(args.listen_unix), "unix"))
    if args.listen_vsock is not None:
        listeners.append((bind_vsock(args.listen_vsock), "vsock"))
    for spec in args.listen_otlp:
        listeners.append((bind_tcp(spec), "otlp"))
    if not listeners:
        log_err("no listening sockets (expected systemd socket activation or --listen-*)")
        return 1
    for sock, name in listeners:
        if name not in ("vsock", "unix", "otlp"):
            log_err(f"ignoring socket with unknown FileDescriptorName {name!r}")
            continue
        daemon.serve(sock, name)
        log(f"listening: {name} {sock.getsockname()!r}")

    stop = threading.Event()
    signal.signal(signal.SIGTERM, lambda *_: stop.set())
    signal.signal(signal.SIGINT, lambda *_: stop.set())
    signal.signal(signal.SIGHUP, lambda *_: registry.refresh())
    stop.wait()
    store.sync()
    return 0


if __name__ == "__main__":
    sys.exit(main())
