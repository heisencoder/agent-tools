#!/usr/bin/python3 -I
# agent-logd — central receiver and store for agent audit records (host).
#
# Runs as system user agent-logd (agent-logd.service) and takes its listening
# sockets from systemd socket units (docs/design/implementation.md, "agent-logd"):
#
#   agent-logd-vsock.socket  vsock::700               FileDescriptorName=vsock
#   agent-logd-unix.socket   /run/agent-logd/ingest.sock (0600 root)  =unix
#   agent-logd-otlp.socket   127.0.0.1:4318, 192.168.123.1:4318       =otlp
#
# Sender authentication comes from the transport, never from the payload:
#   vsock  peer CID must be listed in /etc/agent-tools/envs.conf and the
#          source port must be <= 1023 (bound by root in the VM); CID 1
#          (host loopback), CID 2 and unknown CIDs are rejected.  env = name.
#   unix   SO_PEERCRED uid must be 0.  env = "host".
#
# Ingest protocol (shared with agent-log-shipper): NDJSON envelopes, each
# batch ending with {"batch": n}; after fsync we answer {"ack": n}.
#
# Store: /var/log/agent-audit/<env>/<YYYY-MM-DD>.jsonl (UTC date of
# recv_ts), directories 2750 agent-logd:agent-audit, files 0640.  Lines over
# 2 MiB become "meta oversize" records; each environment may write 2 GiB per
# day, after which one "quota-exceeded" record is written and the rest are
# dropped (still acked, so a shipper never retries forever).
#
# Optional OTLP/HTTP JSON receiver (POST /v1/logs, /v1/metrics): records are
# flattened to source=otel, env=host, client_env from the source address.
# They are stored in host/otel-<DATE>.jsonl with their own quota, so a flood
# of (unauthenticated) OTLP posts cannot use up the host's hook-record quota.
#
# Usage:
#   agent-logd                          # under systemd (socket activation)
#   agent-logd --store DIR --listen-unix PATH [--allow-any-uid]   # dev/tests
#
# Standard library only; Python >= 3.12.

import argparse
import gzip
import hashlib
import io
import json
import os
import re
import signal
import socket
import socketserver
import stat
import struct
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

STORE = "/var/log/agent-audit"
ENVS_CONF = "/etc/agent-tools/envs.conf"
LINE_MAX = 2 << 20               # a stored line over this becomes meta oversize
QUOTA = 2 << 30                  # bytes per environment per day
OTLP_BODY_MAX = 16 << 20
IDLE_TIMEOUT = 600.0             # seconds an ingest connection may sit idle
VSOCK_PRIVILEGED_MAX = 1023
CID_LOOPBACK, CID_HOST = 1, 2

SOURCES = frozenset({"hook", "audit", "egress", "netfilter", "transcript", "otel", "meta"})
ENVELOPE_KEYS = ("ts", "recv_ts", "env", "client_env", "boot_id", "source", "source_id",
                 "run_id", "session_id", "agent_id", "uid", "auid", "ses", "pid", "event", "data")
NAME_RE = re.compile(r"[a-z0-9][a-z0-9-]*\Z")
SOURCE_RE = re.compile(rb'"source"\s*:\s*"((?:[^"\\]|\\.){0,256})"')
SOURCE_ID_RE = re.compile(rb'"source_id"\s*:\s*"((?:[^"\\]|\\.){0,4096})"')


def log(msg, level=6):
    for line in str(msg).splitlines() or [""]:
        print(f"<{level}>{line}", file=sys.stderr, flush=True)


def log_err(msg):
    log(msg, 3)


def utc_iso(t):
    ms = int(round(t * 1000))
    return time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(ms // 1000)) + ".%03dZ" % (ms % 1000)


def encode_json(obj):
    try:
        return json.dumps(obj, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    except UnicodeEncodeError:
        return json.dumps(obj, ensure_ascii=True, separators=(",", ":")).encode("ascii")


def parse_envs_conf(path):
    """Parse envs.conf into [{"name", "cid", "ip", "mac"}].  A missing file
    is an empty registry; a malformed one raises ValueError.  (Duplicated
    from agent-log-shipper so each program stays a single file.)"""
    envs = []
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except FileNotFoundError:
        return envs
    for lineno, line in enumerate(text.splitlines(), 1):
        line = line.split("#", 1)[0].strip()
        if not line:
            continue
        name, *fields = line.split()
        if not NAME_RE.match(name) or name == "host":
            raise ValueError(f"{path}:{lineno}: bad environment name {name!r}")
        entry = {"name": name}
        for field in fields:
            key, sep, value = field.partition("=")
            if not sep:
                raise ValueError(f"{path}:{lineno}: expected key=value, got {field!r}")
            entry[key] = value
        if "cid" in entry:
            entry["cid"] = int(entry["cid"])
        envs.append(entry)
    return envs


class Registry:
    """envs.conf, re-read whenever its mtime changes.  A malformed file
    fails closed: no VM is recognized until it is fixed."""

    def __init__(self, path):
        self.path = path
        self.lock = threading.Lock()
        self.mtime = None
        self.by_cid, self.by_ip = {}, {}

    def refresh(self):
        try:
            mtime = os.stat(self.path).st_mtime_ns
        except FileNotFoundError:
            mtime = None
        with self.lock:
            if mtime == self.mtime and self.mtime is not None:
                return
            self.mtime = mtime
            try:
                envs = parse_envs_conf(self.path)
            except (OSError, ValueError) as e:
                log_err(f"envs.conf: {e}; rejecting all VM peers until fixed")
                envs = []
            self.by_cid = {e["cid"]: e["name"] for e in envs if "cid" in e}
            self.by_ip = {e["ip"]: e["name"] for e in envs if "ip" in e}

    def cids(self):
        self.refresh()
        return dict(self.by_cid)

    def env_for_ip(self, ip):
        self.refresh()
        if ip.startswith("::ffff:"):
            ip = ip[len("::ffff:"):]
        if ip in ("127.0.0.1", "::1"):
            return "host"
        return self.by_ip.get(ip)


# -----------------------------------------------------------------
# Peer checks (pure functions, unit-tested with injected addresses)
# -----------------------------------------------------------------

def check_vsock_peer(cid, port, cid_to_env, allow_loopback=False, allow_unprivileged=False):
    """-> (env, None) to accept or (None, reason) to reject.  The test-only
    flags admit CID 1 and unprivileged source ports."""
    if cid == CID_HOST or (cid == CID_LOOPBACK and not allow_loopback):
        return None, f"reserved CID {cid}"
    env = cid_to_env.get(cid)
    if env is None:
        return None, f"unknown CID {cid}"
    if port > VSOCK_PRIVILEGED_MAX and not allow_unprivileged:
        return None, f"unprivileged source port {port} from CID {cid} ({env})"
    return env, None


def check_unix_peer(uid, allow_any_uid=False):
    if uid == 0 or allow_any_uid:
        return "host", None
    return None, f"peer uid {uid} is not root"


