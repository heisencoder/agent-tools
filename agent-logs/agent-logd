# Store
# -----------------------------------------------------------------

class Store:
    """Per-environment daily JSONL files with a byte quota per file."""

    def __init__(self, root, quota=QUOTA, fsync=os.fsync):
        self.root = root
        self.quota = quota
        self.fsync = fsync
        self.lock = threading.Lock()
        self.files = {}          # (env, name) -> {"fd", "size", "exceeded"}
        self.dirty = set()

    def _env_dir(self, env):
        if not NAME_RE.match(env):
            raise ValueError(f"bad environment name {env!r}")
        path = os.path.join(self.root, env)
        try:
            os.mkdir(path, 0o2750)
            os.chmod(path, 0o2750)       # mkdir is subject to the umask
        except FileExistsError:
            pass
        st = os.lstat(path)
        if not stat.S_ISDIR(st.st_mode):
            raise OSError(f"{path} is not a directory")
        return path

    def _file(self, env, name):
        key = (env, name)
        f = self.files.get(key)
        if f is None:
            # Close this environment's files of the same kind (yesterday's).
            def kind(n):
                return n.startswith("otel-")
            for k in [k for k in self.files if k[0] == env and kind(k[1]) == kind(name)]:
                old = self.files.pop(k)["fd"]
                if k in self.dirty:
                    self.fsync(old)
                    self.dirty.discard(k)
                os.close(old)
            directory = self._env_dir(env)
            path = os.path.join(directory, name)
            existed = os.path.exists(path)
            fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC,
                         0o640)
            os.fchmod(fd, 0o640)
            if not existed:
                dfd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
                try:
                    os.fsync(dfd)
                finally:
                    os.close(dfd)
            size = os.fstat(fd).st_size
            # After a restart, a file already at its quota has its
            # quota-exceeded record; do not write another.
            f = self.files[key] = {"fd": fd, "size": size, "exceeded": size >= self.quota}
        return key, f

    def append(self, env, rec, otel=False):
        """Append one normalized record (not yet durable).  Returns False if
        it was dropped by the quota."""
        date = rec["recv_ts"][:10]
        name = f"otel-{date}.jsonl" if otel else f"{date}.jsonl"
        line = encode_json(rec) + b"\n"
        with self.lock:
            key, f = self._file(env, name)
            if f["size"] + len(line) > self.quota:
                if not f["exceeded"]:
                    f["exceeded"] = True
                    note = normalize({"source": "meta", "source_id": f"quota:{name}",
                                      "event": "quota-exceeded",
                                      "data": {"file": name, "quota_bytes": self.quota}},
                                     env, rec["recv_ts"])
                    self._write(key, f, encode_json(note) + b"\n")
                    log_err(f"{env}: quota of {self.quota} bytes reached for {name}; dropping records")
                return False
            self._write(key, f, line)
            return True

    def _write(self, key, f, data):
        os.write(f["fd"], data)
        f["size"] += len(data)
        self.dirty.add(key)

    def sync(self):
        with self.lock:
            for key in list(self.dirty):
                if key in self.files:
                    self.fsync(self.files[key]["fd"])
            self.dirty.clear()


def normalize(rec, env, recv_ts):
    """Envelope in canonical key order.  env and recv_ts are always ours;
    unknown top-level keys are dropped."""
    out = {k: rec.get(k) for k in ENVELOPE_KEYS}
    out["env"], out["recv_ts"] = env, recv_ts
    if not out["ts"]:
        out["ts"] = recv_ts
    return out


def meta_record(event, source_id, data, env, recv_ts):
    return normalize({"source": "meta", "source_id": source_id, "event": event, "data": data},
                     env, recv_ts)


def read_bounded_line(f, limit=LINE_MAX):
    """Read one line from a binary file object without holding more than
    limit bytes.  Returns None at EOF, ("line", bytes) for a normal line,
    ("oversize", length, sha256, head) for an over-long one, or
    ("partial", bytes) for an unterminated last line."""
    first = f.readline(limit + 1)
    if not first:
        return None
    if first.endswith(b"\n"):
        return ("line", first[:-1])
    if len(first) <= limit:
        return ("partial", first)
    h, n, head = hashlib.sha256(first), len(first), first[:65536]
    while True:
        chunk = f.readline(1 << 20)
        if not chunk:
            break
        if chunk.endswith(b"\n"):
            h.update(chunk[:-1])
            n += len(chunk) - 1
            break
        h.update(chunk)
        n += len(chunk)
    return ("oversize", n, h.hexdigest(), head)


def _regex_str(regex, head):
    m = regex.search(head)
    if not m:
        return None
    try:
        return json.loads(b'"' + m.group(1) + b'"')
    except ValueError:
        return None


def process_line(item, env, recv_ts):
    """One read_bounded_line() result -> ("batch", n) | ("record", rec)."""
    if item[0] == "oversize":
        _, length, digest, head = item
        src, sid = _regex_str(SOURCE_RE, head), _regex_str(SOURCE_ID_RE, head)
        data = {"source": src, "source_id": sid, "length": length, "sha256": digest}
        return ("record", meta_record("oversize", f"oversize:{src}:{sid}:{digest}", data,
                                      env, recv_ts))
    line = item[1]
    try:
        obj = json.loads(line)
    except (ValueError, RecursionError):
        obj = None
    if isinstance(obj, dict) and list(obj) == ["batch"] and type(obj["batch"]) is int:
        return ("batch", obj["batch"])
    if not isinstance(obj, dict) or obj.get("source") not in SOURCES:
        digest = hashlib.sha256(line).hexdigest()
        return ("record", meta_record("invalid-record", f"invalid:{digest}",
                                      {"length": len(line), "sha256": digest}, env, recv_ts))
    return ("record", normalize(obj, env, recv_ts))


def handle_ingest(conn, env, store, idle_timeout=IDLE_TIMEOUT):
    """Serve one authenticated shipper connection until it closes."""
    conn.settimeout(idle_timeout)
    f = conn.makefile("rb")
    count = 0
    try:
        while True:
            item = read_bounded_line(f)
            if item is None or item[0] == "partial":
                return count
            kind, value = process_line(item, env, utc_iso(time.time()))
            if kind == "batch":
                store.sync()
                conn.sendall(encode_json({"ack": value}) + b"\n")
            else:
                store.append(env, value)
                count += 1
    finally:
        f.close()


# -----------------------------------------------------------------
# OTLP/HTTP JSON
# -----------------------------------------------------------------

def otlp_value(v):
    """OTLP AnyValue -> plain JSON value."""
    if not isinstance(v, dict):
        return v
    for key in ("stringValue", "boolValue", "doubleValue", "bytesValue"):
        if key in v:
            return v[key]
    if "intValue" in v:
        try:
            return int(v["intValue"])
        except (TypeError, ValueError):
            return v["intValue"]
    if "arrayValue" in v:
        return [otlp_value(x) for x in (v["arrayValue"] or {}).get("values", []) or []]
    if "kvlistValue" in v:
        return otlp_attrs((v["kvlistValue"] or {}).get("values", []))
    return None


def otlp_attrs(items):
    out = {}
    for a in items or []:
        if isinstance(a, dict) and isinstance(a.get("key"), str):
            out[a["key"]] = otlp_value(a.get("value"))
    return out


def nanos_iso(*values):
    for v in values:
        try:
            n = int(v)
        except (TypeError, ValueError):
            continue
        if n > 0:
            return utc_iso(n / 1e9)
    return None


def otel_record(event, ts, data, client_env, recv_ts):
    attrs = data.get("attributes") or {}
    rec = {"ts": ts, "client_env": client_env, "source": "otel", "event": event,
           "session_id": attrs.get("session.id") if isinstance(attrs.get("session.id"), str) else None,
           "data": data}
    # No natural ID: derive one from the content, so a retried export of the
    # same record de-duplicates at query time.
    rec["source_id"] = hashlib.sha256(encode_json([client_env, ts, data])).hexdigest()[:32]
    return normalize(rec, "host", recv_ts)


def _list(obj, key):
    v = obj.get(key) if isinstance(obj, dict) else None
    return [x for x in v if isinstance(x, dict)] if isinstance(v, list) else []


def flatten_logs(body, client_env, recv_ts):
    out = []
    for rl in _list(body, "resourceLogs"):
        resource = otlp_attrs((rl.get("resource") or {}).get("attributes"))
        for sl in _list(rl, "scopeLogs"):
            scope = (sl.get("scope") or {}).get("name")
            for lr in _list(sl, "logRecords"):
                attrs = otlp_attrs(lr.get("attributes"))
                value = otlp_value(lr.get("body"))
                name = attrs.get("event.name") or (value if isinstance(value, str) else None) or "log"
                name = str(name)
                data = {"kind": "log", "name": name, "attributes": attrs, "body": value,
                        "severity": lr.get("severityText"), "resource": resource, "scope": scope}
                ts = nanos_iso(lr.get("timeUnixNano"), lr.get("observedTimeUnixNano")) or recv_ts
                out.append(otel_record(name.removeprefix("claude_code."), ts, data, client_env,
                                       recv_ts))
    return out


def flatten_metrics(body, client_env, recv_ts):
    out = []
    for rm in _list(body, "resourceMetrics"):
        resource = otlp_attrs((rm.get("resource") or {}).get("attributes"))
        for sm in _list(rm, "scopeMetrics"):
            scope = (sm.get("scope") or {}).get("name")
            for metric in _list(sm, "metrics"):
                name = str(metric.get("name") or "metric")
                for mtype in ("sum", "gauge", "histogram", "exponentialHistogram", "summary"):
                    if isinstance(metric.get(mtype), dict):
                        break
                else:
                    continue
                for dp in _list(metric[mtype], "dataPoints"):
                    value = dp.get("asDouble", dp.get("asInt"))
                    if isinstance(value, str):
                        try:
                            value = int(value)
                        except ValueError:
                            pass
                    data = {"kind": "metric", "name": name, "type": mtype,
                            "unit": metric.get("unit"), "value": value,
                            "attributes": otlp_attrs(dp.get("attributes")),
                            "resource": resource, "scope": scope}
                    for extra in ("count", "sum", "min", "max"):
                        if extra in dp:
                            data[extra] = dp[extra]
                    ts = nanos_iso(dp.get("timeUnixNano"), dp.get("startTimeUnixNano")) or recv_ts
                    out.append(otel_record(name.removeprefix("claude_code."), ts, data,
                                           client_env, recv_ts))
    return out


class OTLPHandler(BaseHTTPRequestHandler):
    server_version = "agent-logd"
    timeout = 30
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):     # quiet: errors are logged explicitly
        pass

    def reply(self, code, body=b"{}"):
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        self.reply(405)

    def do_POST(self):
        logd = self.server.logd
        # Consume the body first so a keep-alive connection stays in sync
        # whatever we answer.
        try:
            length = int(self.headers.get("Content-Length", ""))
        except ValueError:
            self.close_connection = True
            return self.reply(411)
        if not 0 <= length <= OTLP_BODY_MAX:
            self.close_connection = True
            return self.reply(413)
        body = self.rfile.read(length)
        path = self.path.split("?", 1)[0]
        flatten = {"/v1/logs": flatten_logs, "/v1/metrics": flatten_metrics}.get(path)
        if flatten is None:
            return self.reply(404)
        client_env = logd.registry.env_for_ip(self.client_address[0])
        if client_env is None:
            log_err(f"otlp: rejecting unknown client {self.client_address[0]}")
            return self.reply(403)
        if "json" not in (self.headers.get("Content-Type") or ""):
            return self.reply(415)
        try:
            if (self.headers.get("Content-Encoding") or "").lower() == "gzip":
                with gzip.GzipFile(fileobj=io.BytesIO(body)) as gz:
                    body = gz.read(OTLP_BODY_MAX + 1)
                if len(body) > OTLP_BODY_MAX:
                    return self.reply(413)
            records = flatten(json.loads(body), client_env, utc_iso(time.time()))
        except (ValueError, OSError, EOFError, RecursionError, AttributeError, TypeError) as e:
            log_err(f"otlp: bad request from {client_env}: {e}")
            return self.reply(400)
        logd.store_records("host", records, otel=True)
        self.reply(200)


class OTLPServer(ThreadingHTTPServer):
    daemon_threads = True

    def __init__(self, sock, logd):
        # Use an already-bound listening socket (from systemd or the caller).
        socketserver.BaseServer.__init__(self, sock.getsockname(), OTLPHandler)
        self.socket = sock
        self.server_name, self.server_port = "agent-logd", sock.getsockname()[1]
        self.logd = logd


