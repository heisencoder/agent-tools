def parse_args(argv):
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--store", default=STORE, help=f"store directory (default {STORE})")
    common.add_argument("--json", action="store_true", help="machine-readable output")
    common.add_argument("--since", type=parse_since, help="e.g. 2h, 1d, 2026-10-27")
    p = argparse.ArgumentParser(prog="agent-log", description="Query the agent audit store.")
    sub = p.add_subparsers(dest="cmd", required=True)
    sp = sub.add_parser("sessions", parents=[common], help="list sessions")
    sp.add_argument("--env")
    sp = sub.add_parser("timeline", parents=[common], help="merged view of one session")
    sp.add_argument("session")
    for flag in ("exec", "net", "transcript", "otel", "all"):
        sp.add_argument(f"--{flag}", action="store_true")
    sp = sub.add_parser("net", parents=[common], help="proxy decisions and firewall drops")
    sp.add_argument("--denied", action="store_true")
    sp.add_argument("--env", help="environment the traffic came from (client_env)")
    sp = sub.add_parser("exec", parents=[common], help="process tree of one session")
    sp.add_argument("session")
    sp = sub.add_parser("tail", parents=[common], help="follow new records")
    sp.add_argument("--env")
    sp.add_argument("--from-start", action="store_true", help="print existing records first")
    sp = sub.add_parser("verify", parents=[common], help="consistency and tamper checks")
    sp.add_argument("session", nargs="?")
    sp.add_argument("--env")
    return p.parse_args(argv)


def main(argv=None):
    args = parse_args(argv)
    commands = {"sessions": cmd_sessions, "timeline": cmd_timeline, "net": cmd_net,
                "exec": cmd_exec, "tail": cmd_tail, "verify": cmd_verify}
    # --since also skips whole day files older than (since - 1 day).
    records = [] if args.cmd == "tail" else load(args.store, args.since)
    try:
        return commands[args.cmd](args, records) or 0
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    sys.exit(main())
