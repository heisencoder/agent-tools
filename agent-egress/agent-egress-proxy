# Listeners
# -----------------------------------------------------------------
def sockets_from_systemd(environ=None):
    """Return listening sockets passed by systemd (sd_listen_fds protocol):
    fds 3 .. 3+LISTEN_FDS-1, valid only if LISTEN_PID is our PID.  The
    variables are removed so they are not inherited."""
    environ = os.environ if environ is None else environ
    try:
        if int(environ.get("LISTEN_PID", "")) != os.getpid():
            return []
        count = int(environ.get("LISTEN_FDS", ""))
    except ValueError:
        return []
    finally:
        for key in ("LISTEN_PID", "LISTEN_FDS", "LISTEN_FDNAMES"):
            environ.pop(key, None)
    socks = []
    for fd in range(3, 3 + count):
        sock = socket.socket(fileno=fd)
        if sock.type != socket.SOCK_STREAM or \
                sock.family not in (socket.AF_INET, socket.AF_INET6):
            raise ConfigError(f"fd {fd} is not a TCP socket")
        socks.append(sock)
    return socks


def listener_kind(sock):
    """Loopback listeners serve the host; all others serve VMs."""
    ip = embedded_ipv4(ipaddress.ip_address(sock.getsockname()[0]))
    return "host" if ip.is_loopback else "vm"


def listen_socket(spec):
    """--listen ADDR:PORT[=host|vm] → (socket, kind)."""
    addr_port, _, kind = spec.partition("=")
    if kind not in ("", "host", "vm"):
        raise ConfigError(f"--listen {spec}: kind must be host or vm")
    host, sep, port = addr_port.rpartition(":")
    host = host.strip("[]")
    if not sep or not port.isdigit():
        raise ConfigError(f"--listen {spec}: expected ADDR:PORT")
    family = socket.AF_INET6 if ":" in host else socket.AF_INET
    sock = socket.socket(family, socket.SOCK_STREAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    sock.bind((host, int(port)))
    sock.listen(128)
    return sock, kind or listener_kind(sock)


async def run(proxy, listeners):
    await proxy.start(listeners)
    loop = asyncio.get_running_loop()
    stop = asyncio.Event()
    loop.add_signal_handler(signal.SIGHUP, proxy.reload)
    loop.add_signal_handler(signal.SIGTERM, stop.set)
    loop.add_signal_handler(signal.SIGINT, stop.set)
    for sock, kind in listeners:
        name = sock.getsockname()
        warn(f"listening on {name[0]}:{name[1]} ({kind}); "
             f"{len(proxy.allowlist)} allowlist entries, "
             f"{len(proxy.vm_clients)} VM clients")
    await stop.wait()
    await proxy.close()


def main(argv=None):
    # A reload that arrives before the asyncio handler is installed must not
    # kill the process (SIGHUP's default action).
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    parser = argparse.ArgumentParser(
        description="Allowlisting HTTP CONNECT/GET proxy for coding agents.")
    parser.add_argument("--allowlist-dir", default=DEFAULT_ALLOWLIST_DIR)
    parser.add_argument("--envs-conf", default=DEFAULT_ENVS_CONF)
    parser.add_argument("--listen", action="append", default=[],
                        metavar="ADDR:PORT[=host|vm]",
                        help="listen here in addition to any sockets passed "
                             "by systemd; kind defaults to host for loopback "
                             "addresses and vm otherwise")
    args = parser.parse_args(argv)
    try:
        listeners = [(s, listener_kind(s)) for s in sockets_from_systemd()]
        listeners += [listen_socket(spec) for spec in args.listen]
        proxy = Proxy(args.allowlist_dir, args.envs_conf)
    except (ConfigError, OSError) as e:
        warn(str(e))
        return 1
    if not listeners:
        warn("no listening sockets: use socket activation or --listen")
        return 2
    asyncio.run(run(proxy, listeners))
    return 0


if __name__ == "__main__":
    sys.exit(main())
